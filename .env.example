# =============================================================================
# ReviewReply-Lite — environment variables
# =============================================================================
# This is the TEMPLATE. Copy to `.env.local` and fill in real values for real
# providers. For the mock-mode build (USE_MOCKS=true), all PROVIDER keys below
# may stay blank — no real third-party account is required to run the app.
#
# Per AGENTS.md Section 4 / Data-Handling-Policy.md Section 3: never commit
# `.env.local` with real values. `.gitignore` already excludes it.
# =============================================================================

# --- MOCK MODE -------------------------------------------------------------
# Default ON for this build. When true, every lib/integrations/* and lib/ai/*
# function returns mock data and never calls a real third-party API.
# Flip to false and fill the real keys below to go live (see MOCK-TO-REAL.md).
USE_MOCKS=true

# --- APP -------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- SUPABASE (locked DB + Auth) -------------------------------------------
# Required for real mode. In mock mode these may be blank; the app falls back
# to a local file-backed store (see lib/supabase/local-store.ts).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- ANTHROPIC (AI reply drafting) -----------------------------------------
# Model locked: claude-sonnet-4-6. Leave blank in mock mode (template-based
# generator is used instead — see lib/ai/draft-reply.ts).
ANTHROPIC_API_KEY=

# --- GOOGLE BUSINESS PROFILE -----------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_BUSINESS_PROFILE_API_KEY=

# --- FACEBOOK / META GRAPH -------------------------------------------------
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- TWILIO (SMS review requests) ------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- RESEND (transactional email) ------------------------------------------
RESEND_API_KEY=

# --- STRIPE (subscriptions + metered overage) ------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_STARTER=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_OVERAGE=

# --- INNGEST (background jobs) ---------------------------------------------
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- OBSERVABILITY (optional in mock mode) ---------------------------------
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=