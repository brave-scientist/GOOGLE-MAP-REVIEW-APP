// ReviewReply Enterprise — Prisma schema
// Multi-tenant: Organization → Businesses → Users
// Core entities: Reviews, ReviewRequests, Campaigns, ReplyDrafts

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                      String       @id @default(cuid())
  name                    String
  plan                    Plan         @default(FREE)
  stripeCustomerId        String?
  stripeSubscriptionId    String?
  stripeSubscriptionStatus String?
  trialEndsAt             DateTime?
  onboardingStep          Int          @default(1)
  onboardingCompletedAt   DateTime?
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
  businesses              Business[]
  members                 OrgMember[]
  scheduledReports        ScheduledReport[]
  teamInvitations         TeamInvitation[]
  deletionRequests        DeletionRequest[]
  locationGroups          LocationGroup[]
  operatorLocationAssignments OperatorLocationAssignment[]
  operatorGroupAssignments    OperatorGroupAssignment[]
  agencyBranding              AgencyBranding?
  customDomains               CustomDomain[]
  clientPortalShares          ClientPortalShare[]
  reportDeliveryLogs          ReportDeliveryLog[]
  billingCustomers            BillingCustomer[]
  subscriptions               Subscription[]
  usageCounters               UsageCounter[]
}

model OrgMember {
  id        String   @id @default(cuid())
  orgId     String
  userId    String
  role      Role     @default(VIEWER)
  createdAt DateTime @default(now())
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
}

model User {
  id                 String               @id @default(cuid())
  email              String               @unique
  name               String?
  avatarUrl          String?
  passwordHash       String?
  sessionVersion     Int                  @default(1)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  memberships        OrgMember[]
  businesses         Business[]           // businesses they own
  passwordResetTokens PasswordResetToken[]
  sentInvitations    TeamInvitation[]
  accounts           Account[]
  deletionRequests   DeletionRequest[]
  operatorLocationAssignments OperatorLocationAssignment[]
  operatorGroupAssignments    OperatorGroupAssignment[]
  assignedEscalations         Escalation[]
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  email             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailOtp {
  id           String    @id @default(cuid())
  email        String
  otpHash      String
  expiresAt    DateTime
  consumedAt   DateTime?
  attempts     Int       @default(0)
  name         String?
  businessName String?
  isNewUser    Boolean   @default(false)
  createdAt    DateTime  @default(now())

  @@index([email, expiresAt])
}

model OAuthTransactionState {
  id         String    @id @default(cuid())
  state      String    @unique
  provider   String
  businessId String
  userId     String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([state, expiresAt])
}

model StripeWebhookEvent {
  id          String    @id @default(cuid())
  eventId     String    @unique
  eventType   String
  status      String    @default("PROCESSING")
  attempts    Int       @default(1)
  lastError   String?
  processedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  @@index([status, createdAt])
}

model BillingCustomer {
  id                 String         @id @default(cuid())
  orgId              String
  provider           String         @default("stripe")
  providerCustomerId String         @unique
  email              String?
  name               String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  org                Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  subscriptions      Subscription[]

  @@unique([orgId, provider])
  @@index([orgId])
  @@index([providerCustomerId])
}

model Subscription {
  id                     String           @id @default(cuid())
  orgId                  String
  customerId             String?
  provider               String           @default("stripe")
  providerCustomerId     String
  providerSubscriptionId String           @unique
  plan                   Plan             @default(FREE)
  status                 String
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean          @default(false)
  canceledAt             DateTime?
  trialStart             DateTime?
  trialEnd               DateTime?
  lastEventTimestamp     DateTime?
  lastEventId            String?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  org                    Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customer               BillingCustomer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([orgId, status])
  @@index([providerCustomerId])
  @@index([status])
}

model UsageCounter {
  id        String       @id @default(cuid())
  orgId     String
  metric    String
  period    String       @default("all-time")
  count     Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, metric, period])
  @@index([orgId, metric])
}


model Business {
  id                  String               @id @default(cuid())
  orgId               String?
  ownerId             String
  name                String
  industry            String?
  address             String?
  phone               String?
  timezone            String               @default("America/New_York")
  googleLocationId       String?
  googlePlaceId          String?              // Google Maps Place ID (e.g. ChIJ...)
  googleLocationVerified Boolean              @default(false) // true only after server-side Google API verification
  googleSyncStatus       String?              // null | 'pending' | 'syncing' | 'completed' | 'failed'
  googleSyncError        String?              // safe error message (no tokens/credentials)
  googleSyncedAt         DateTime?            // timestamp of last successful sync
  facebookPageId         String?
  slug                              String?              @unique // for public /review-us/[slug] pages
  reviewPageTitle                   String?
  reviewPageSubtitle                String?
  reviewPagePrivateFeedbackEnabled  Boolean              @default(true)
  avgRating                         Float                @default(0)
  reviewCount         Int                  @default(0)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  org                 Organization?        @relation(fields: [orgId], references: [id])
  owner               User                 @relation(fields: [ownerId], references: [id])
  reviews             Review[]
  reviewRequests      ReviewRequest[]
  campaigns           Campaign[]
  replyTemplates      ReplyTemplate[]
  brandVoiceProfile   BrandVoiceProfile?
  oauthTokens         OAuthToken[]
  reviewPlatformLinks ReviewPlatformLink[]
  reviewUsSends       ReviewUsSend[]
  competitors         Competitor[]
  scheduledReports    ScheduledReport[]
  smsDeliveries       SmsDeliveryEvent[]
  smsConsents         CustomerSmsConsent[]
  smsConsentEvents    CustomerSmsConsentEvent[]
  smsConsentInvitations CustomerSmsConsentInvitation[]
  locationGroupMemberships LocationGroupMembership[]
  operatorAssignments OperatorLocationAssignment[]
  aiReplyPresets      AiReplyPreset[]
  automationRules     AutomationRule[]
  escalations         Escalation[]
  clientPortalShares  ClientPortalShare[]
}

model Review {
  id              String                 @id @default(cuid())
  businessId      String
  source          ReviewSource
  externalId      String
  author          String
  authorAvatar    String?
  rating          Int
  title           String?
  text            String
  language        String                 @default("en")
  sentimentScore  Float?                 // -1.0 to 1.0
  topics          String?                // JSON array as string (SQLite limitation)
  replyText       String?
  repliedAt       DateTime?
  repliedBy       String?
  draftText       String?
  draftStatus     DraftStatus            @default(NONE)
  createdAt       DateTime               @default(now())
  fetchedAt       DateTime               @default(now())
  business        Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  publishAttempts ReviewPublishAttempt[]
  escalations     Escalation[]

  @@unique([source, externalId])
  @@index([businessId, createdAt])
  @@index([businessId, rating])
}

model ReviewPublishAttempt {
  id            String               @id @default(cuid())
  reviewId      String
  platform      ReviewSource
  status        PublishAttemptStatus @default(IN_FLIGHT)
  errorMessage  String?
  remoteId      String?
  idempotencyKey String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  review        Review               @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId, status])
}

enum PublishAttemptStatus {
  IN_FLIGHT
  SUCCESS
  FAILED
  UNCONFIRMED
}

model ReviewRequest {
  id              String        @id @default(cuid())
  businessId      String
  customerName    String
  customerContact String        // phone or email
  channel         Channel
  status          RequestStatus @default(PENDING)
  message         String?
  sentAt          DateTime?
  deliveredAt     DateTime?
  clickedAt       DateTime?
  convertedAt     DateTime?
  campaignId      String?
  createdAt       DateTime      @default(now())
  business        Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  campaign        Campaign?       @relation(fields: [campaignId], references: [id])
  smsDeliveries   SmsDeliveryEvent[]

  @@index([businessId, status])
  @@index([campaignId])
}

model Campaign {
  id              String          @id @default(cuid())
  businessId      String
  name            String
  description     String?
  trigger         String          @default("manual") // manual | event | schedule
  channelMix      String          @default("sms,email") // CSV of channels
  messageTemplate String?
  status          String          @default("draft") // draft | active | paused | completed
  sentCount       Int             @default(0)
  clickCount      Int             @default(0)
  conversionCount Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  business        Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  requests        ReviewRequest[]

  @@index([businessId, status])
}

model ReplyTemplate {
  id         String   @id @default(cuid())
  businessId String
  title      String
  body       String
  language   String   @default("en")
  category   String?  // POSITIVE | NEGATIVE | NEUTRAL | ESCALATION
  usageCount Int      @default(0)
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([businessId, category])
}

model AiReplyPreset {
  id                 String   @id @default(cuid())
  businessId         String
  name               String
  description        String?
  tone               String
  responseLength     String   @default("BALANCED") // CONCISE | BALANCED | DETAILED
  customInstructions String?
  signature          String?
  isDefault          Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt
  business           Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([businessId, isDefault])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  targetType String?
  targetId   String?
  metadata   String?  // JSON string
  ip         String?
  createdAt  DateTime @default(now())
}

// ── Enums ──────────────────────────────────────
enum Plan {
  FREE
  STARTER
  PRO
  ENTERPRISE
  AGENCY
  CUSTOM
}

enum Role {
  OWNER
  ADMIN
  STAFF
  VIEWER
  AGENCY_ADMIN
  AGENCY_STAFF
  CLIENT_ADMIN
  CLIENT_STAFF
}

enum ReviewSource {
  GOOGLE
  FACEBOOK
  YELP
  TRUSTPILOT
  APPLE_MAPS
  BING_PLACES
  INTERNAL
}

enum DraftStatus {
  NONE
  DRAFT
  PENDING
  APPROVED
  REJECTED
  POSTING
  POSTED
}

enum Channel {
  SMS
  EMAIL
  QR
  WHATSAPP
  APPLE_CHAT
}

enum RequestStatus {
  PENDING
  SENT
  DELIVERED
  CLICKED
  CONVERTED
  FAILED
  OPTED_OUT
}

model BrandVoiceProfile {
  id               String   @id @default(cuid())
  businessId       String   @unique
  examples         String   @default("[]") // JSON array of {reviewText, replyText} pairs
  toneGuidelines   String   @default("") // Free-text tone/voice guidelines from user
  signature        String   @default("") // Default sign-off
  forbiddenPhrases String   @default("") // Comma-separated phrases to avoid
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  business         Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model OptOut {
  id        String   @id @default(cuid())
  contact   String   @unique // phone number or email
  channel   String   @default("all") // sms, email, or all
  reason    String?  // "STOP keyword", "unsubscribe link", "manual"
  createdAt DateTime @default(now())
}

model OAuthToken {
  id              String    @id @default(cuid())
  businessId      String
  provider        String    // 'google' | 'facebook' | 'apple'
  accessTokenEnc  String    // encrypted access token
  refreshTokenEnc String    // encrypted refresh token
  expiresAt       DateTime?
  scopes          String    @default("") // comma-separated
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  business        Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, provider])
  @@index([businessId])
}

// ─────────────────────────────────────────────────────
// Review Us Page — link-generation feature (no API sync)
// ─────────────────────────────────────────────────────
model ReviewPlatformLink {
  id            String   @id @default(cuid())
  businessId    String
  platformId    String?  // matches the `id` field in the catalog; null if custom
  customName    String?  // name for custom platforms (when platformId is null)
  customIconUrl String?  // optional icon for custom platforms
  url           String   // the business's specific review-submission URL on this platform
  enabled       Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, enabled])
}

// ─────────────────────────────────────────────────────
// Review Us Page — bulk-send records (separate from Campaign)
// ─────────────────────────────────────────────────────
model ReviewUsSend {
  id                 String   @id @default(cuid())
  businessId         String
  channel            String
  messageTemplate    String?
  reviewUsUrl        String
  recipientCount     Int      @default(0)
  sentCount          Int      @default(0)
  skippedOptOutCount Int      @default(0)
  failedCount        Int      @default(0)
  sentAt             DateTime @default(now())

  business           Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  recipients         ReviewUsSendRecipient[]

  @@index([businessId, sentAt])
}

model ReviewUsSendRecipient {
  id              String       @id @default(cuid())
  reviewUsSendId  String
  customerName    String
  customerContact String
  channel         String
  status          String       @default("pending")
  sentAt          DateTime?
  deliveredAt     DateTime?
  error           String?

  reviewUsSend    ReviewUsSend @relation(fields: [reviewUsSendId], references: [id], onDelete: Cascade)

  @@index([reviewUsSendId])
}

// ─────────────────────────────────────────────────────
// DB-002: Competitor Intelligence Persistence
// ─────────────────────────────────────────────────────
model Competitor {
  id             String               @id @default(cuid())
  businessId     String
  name           String
  googleMapsUrl  String?
  placeId        String?
  rating         Float                @default(0.0)
  reviewCount    Int                  @default(0)
  responseRate   Float                @default(0.0)
  sentimentScore Float?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  snapshots      CompetitorSnapshot[]

  business       Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model CompetitorSnapshot {
  id             String     @id @default(cuid())
  competitorId   String
  rating         Float
  reviewCount    Int
  sentimentScore Float?
  capturedAt     DateTime   @default(now())

  competitor     Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@index([competitorId, capturedAt])
}

// ─────────────────────────────────────────────────────
// DB-003: Scheduled Reports Persistence
// ─────────────────────────────────────────────────────
model ScheduledReport {
  id          String         @id @default(cuid())
  orgId       String
  businessId  String?
  name        String
  schedule    ReportSchedule
  recipients  String         // JSON array of recipient emails/contacts
  format      ReportFormat
  status      ReportStatus   @default(ACTIVE)
  timezone    String         @default("UTC")
  reportType  String         @default("EXECUTIVE_SUMMARY")
  lastSentAt  DateTime?
  nextRunAt   DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  org         Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  business    Business?      @relation(fields: [businessId], references: [id])
  deliveryLogs ReportDeliveryLog[]

  @@index([orgId, status])
  @@index([businessId])
}

enum ReportSchedule {
  DAILY
  WEEKLY
  MONTHLY
  REALTIME_ALERT
}

enum ReportFormat {
  EMAIL_HTML
  PDF_ATTACHMENT
  BOTH
}

enum ReportStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

// ─────────────────────────────────────────────────────
// AUTH-003: Cryptographic Team Invitations
// ─────────────────────────────────────────────────────
model TeamInvitation {
  id          String       @id @default(cuid())
  orgId       String
  email       String
  role        Role         @default(STAFF)
  tokenHash   String       @unique
  invitedById String
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime     @default(now())

  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invitedBy   User         @relation(fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([orgId, email])
}

// ─────────────────────────────────────────────────────
// SMS-001: Telnyx SMS Foundation & Delivery Tracking
// SMS-001.1: Hardened — nullable providerMessageId,
//   dispatchId for internal correlation, statusOrdinal
//   for monotonic delivery state transitions
// ─────────────────────────────────────────────────────
model SmsDeliveryEvent {
  id                String         @id @default(cuid())
  dispatchId        String         @unique @default(cuid()) // Internal correlation ID (always present)
  provider          String         // 'telnyx' | 'twilio'
  providerMessageId String?        @unique // Provider-generated ID; NULL on rejection/network failure
  businessId        String
  reviewRequestId   String?
  recipientId       String?
  to                String         // E.164 formatted
  from              String         // E.164 formatted or 'UNCONFIGURED'
  status            SmsStatus      @default(QUEUED)
  statusOrdinal     Int            @default(0) // Monotonic: prevents webhook status regressions
  errorCode         String?
  errorMessage      String?
  segments          Int            @default(1)
  cost              Float?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  business          Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  reviewRequest     ReviewRequest? @relation(fields: [reviewRequestId], references: [id], onDelete: SetNull)

  @@index([businessId, status])
  @@index([reviewRequestId])
  @@index([to, businessId, createdAt]) // Cooldown query optimization
}

enum SmsStatus {
  QUEUED
  SENDING
  SENT
  DELIVERED
  FAILED
  UNDELIVERED
}

model SmsWebhookEvent {
  id          String    @id @default(cuid())
  provider    String    // 'telnyx' | 'twilio'
  eventId     String    @unique
  eventType   String
  payload     String?
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([provider, eventId])
}

// ─────────────────────────────────────────────────────
// SMS-002.1: Controlled SMS Disclosure Templates
// ─────────────────────────────────────────────────────
model SmsDisclosureTemplate {
  id           String   @id @default(cuid())
  version      String   @unique // e.g. "v1", "v2"
  purpose      String   @default("REVIEW_REQUEST")
  title        String
  bodyTemplate String   // Standard text with {businessName} placeholder
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  events       CustomerSmsConsentEvent[]
  invitations  CustomerSmsConsentInvitation[]
}

// ─────────────────────────────────────────────────────
// SMS-002.1: Active Affirmative SMS Consent State
// Fast status resolution pointer for dispatch gates
// ─────────────────────────────────────────────────────
model CustomerSmsConsent {
  id             String           @id @default(cuid())
  businessId     String
  contact        String           // Normalized E.164 (+1XXXXXXXXXX)
  status         ConsentStatus    @default(ACTIVE)
  consentType    SmsConsentType   @default(EXPRESS_WRITTEN)
  consentSource  SmsConsentSource @default(CUSTOMER_WEB_FORM)
  currentVersion String?          // Latest disclosure version consented to
  lastEventId    String?          // Pointer to latest immutable event
  disclosureText String?          // Verbatim snapshot of latest disclosure text
  ipAddress      String?
  userAgent      String?
  consentedAt    DateTime         @default(now())
  revokedAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  business       Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  events         CustomerSmsConsentEvent[]

  @@unique([businessId, contact])
  @@index([businessId, status])
  @@index([businessId, contact])
  @@index([businessId, consentedAt])
}

enum ConsentStatus {
  ACTIVE
  REVOKED
  UNVERIFIED_LEGACY
}

enum SmsConsentType {
  EXPRESS_WRITTEN
  TRANSACTIONAL
  IMPLIED
}

enum SmsConsentSource {
  CUSTOMER_WEB_FORM
  VERIFIED_API_IMPORT
  IN_PERSON_KIOSK
  CHECKOUT_FORM
  WEBSITE_FORM
  LEGACY_IMPORT
  MANUAL_ENTRY
  STAFF_RECORDED
}

// ─────────────────────────────────────────────────────
// SMS-002.1: Immutable Consent Event Ledger
// Append-only legal evidence ledger for TCPA/CTIA audits
// ─────────────────────────────────────────────────────
model CustomerSmsConsentEvent {
  id                  String                @id @default(cuid())
  consentId           String?
  businessId          String
  contact             String                // Normalized E.164
  eventType           ConsentEventType      // GRANTED, REVOKED, REGRANTED, IMPORTED, MIGRATED_LEGACY
  consentType         SmsConsentType
  consentSource       SmsConsentSource
  disclosureTemplateId String?
  disclosureVersion   String                // e.g. "v1"
  disclosureText      String                // Exact verbatim text shown at consent time
  ipAddress           String?
  userAgent           String?
  sourceUrl           String?               // Public URL/page where consent was captured
  externalSystem      String?               // For API imports (e.g. "Shopify POS")
  externalRecordId    String?               // External system ID
  externalTimestamp   DateTime?             // When customer consented in external system
  evidenceMetadata    String?               // Structured JSON metadata
  actorId             String?               // Staff User ID or null for customer-originated
  occurredAt          DateTime              @default(now())
  createdAt           DateTime              @default(now())

  business            Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  consent             CustomerSmsConsent?   @relation(fields: [consentId], references: [id], onDelete: Cascade)
  disclosureTemplate  SmsDisclosureTemplate? @relation(fields: [disclosureTemplateId], references: [id])

  @@index([businessId, contact, createdAt])
  @@index([consentId])
}

enum ConsentEventType {
  GRANTED
  REVOKED
  REGRANTED
  IMPORTED
  MIGRATED_LEGACY
}

// ─────────────────────────────────────────────────────
// SMS-002.1: Cryptographic Customer Consent Invitations
// Secure, single-use, expiring tokens for customer consent flow
// ─────────────────────────────────────────────────────
model CustomerSmsConsentInvitation {
  id                  String                @id @default(cuid())
  businessId          String
  contact             String                // Normalized E.164
  recipientName       String?
  tokenHash           String                @unique // SHA-256 of raw 32-byte token
  disclosureVersion   String                @default("v1")
  disclosureTemplateId String?
  status              ConsentInviteStatus   @default(PENDING)
  expiresAt           DateTime
  consumedAt          DateTime?
  createdAt           DateTime              @default(now())

  business            Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  disclosureTemplate  SmsDisclosureTemplate? @relation(fields: [disclosureTemplateId], references: [id])

  @@index([businessId, contact])
  @@index([tokenHash])
}

enum ConsentInviteStatus {
  PENDING
  CONSUMED
  EXPIRED
  REVOKED
}

// ─────────────────────────────────────────────────────
// Compliance & GDPR DSAR Deletion Requests
// ─────────────────────────────────────────────────────
model DeletionRequest {
  id           String                @id @default(cuid())
  userId       String
  orgId        String
  status       DeletionRequestStatus @default(PENDING)
  reason       String?
  scheduledFor DateTime
  requestedAt  DateTime              @default(now())
  processedAt  DateTime?
  processedBy  String?
  cancelledAt  DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  org          Organization          @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([orgId, status])
}

enum DeletionRequestStatus {
  PENDING
  PROCESSING
  COMPLETED
  CANCELLED
}

// ─────────────────────────────────────────────────────
// ORG-02: Multi-Location Regional Operator Governance
// ─────────────────────────────────────────────────────
model LocationGroup {
  id                  String                      @id @default(cuid())
  orgId               String
  name                String
  description         String?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt

  org                 Organization                @relation(fields: [orgId], references: [id], onDelete: Cascade)
  locations           LocationGroupMembership[]
  operatorAssignments OperatorGroupAssignment[]

  @@unique([orgId, name])
  @@index([orgId])
}

model LocationGroupMembership {
  id         String        @id @default(cuid())
  groupId    String
  businessId String
  createdAt  DateTime      @default(now())

  group      LocationGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  business   Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([groupId, businessId])
  @@index([businessId])
}

model OperatorLocationAssignment {
  id           String       @id @default(cuid())
  orgId        String
  userId       String
  businessId   String
  assignedById String?
  createdAt    DateTime     @default(now())

  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  business     Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@index([orgId, userId])
  @@index([businessId])
}

model OperatorGroupAssignment {
  id           String        @id @default(cuid())
  orgId        String
  userId       String
  groupId      String
  assignedById String?
  createdAt    DateTime      @default(now())

  org          Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  group        LocationGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
  @@index([orgId, userId])
  @@index([groupId])
}

// ─────────────────────────────────────────────────────
// AUTO-01: Advanced Automation Triggers & Sentiment Escalation Routing
// ─────────────────────────────────────────────────────
model AutomationRule {
  id                 String                 @id @default(cuid())
  businessId         String
  name               String
  description        String?
  triggerType        AutomationTriggerType  @default(NEW_REVIEW)
  isEnabled          Boolean                @default(true)
  minRating          Int?                   // 1 to 5
  maxRating          Int?                   // 1 to 5
  sentimentThreshold SentimentScoreCategory @default(ANY)
  minSeverity        EscalationSeverity     @default(MEDIUM)
  sources            String                 @default("ALL") // "ALL" or comma-separated "GOOGLE,FACEBOOK,INTERNAL"
  actionType         AutomationActionType   @default(CREATE_ESCALATION)
  actionConfig       String?                // JSON: { notifyEmail, autoAssignUserId, customNote }
  cooldownMinutes    Int                    @default(0)
  lastTriggeredAt    DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  business           Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  executions         AutomationExecution[]
  escalations        Escalation[]

  @@index([businessId, isEnabled])
  @@index([businessId, triggerType])
}

enum AutomationTriggerType {
  NEW_REVIEW
  SENTIMENT_ALERT
  RATING_THRESHOLD
  NEGATIVE_FEEDBACK
}

enum SentimentScoreCategory {
  ANY
  NEGATIVE
  NEUTRAL
  POSITIVE
}

enum EscalationSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AutomationActionType {
  CREATE_ESCALATION
  DISPATCH_NOTIFICATION
  ESCALATE_AND_NOTIFY
}

model Escalation {
  id               String             @id @default(cuid())
  businessId       String
  reviewId         String
  ruleId           String?
  status           EscalationStatus   @default(OPEN)
  severity         EscalationSeverity @default(HIGH)
  sentiment        String?            // POSITIVE | NEUTRAL | NEGATIVE
  sentimentScore   Float?
  reason           String
  assignedToUserId String?
  assignedToEmail  String?
  resolutionNotes  String?
  resolvedAt       DateTime?
  resolvedByUserId String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  business         Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  review           Review             @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  rule             AutomationRule?    @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  assignedTo       User?              @relation(fields: [assignedToUserId], references: [id], onDelete: SetNull)
  dispatches       EscalationDispatch[]

  @@unique([reviewId, ruleId])
  @@index([businessId, status])
  @@index([businessId, severity])
  @@index([reviewId])
}

enum EscalationStatus {
  OPEN
  ACKNOWLEDGED
  IN_PROGRESS
  RESOLVED
  DISMISSED
}

model AutomationExecution {
  id             String          @id @default(cuid())
  businessId     String
  ruleId         String
  reviewId       String?
  idempotencyKey String          @unique
  status         ExecutionStatus @default(PENDING)
  matched        Boolean         @default(false)
  sentiment      String?
  severity       String?
  errorMessage   String?
  executedAt     DateTime        @default(now())

  rule           AutomationRule  @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([businessId, executedAt])
  @@index([ruleId, status])
}

enum ExecutionStatus {
  PENDING
  SUCCESS
  FAILED
  SKIPPED
}

model EscalationDispatch {
  id                String         @id @default(cuid())
  escalationId      String
  channel           String         @default("EMAIL") // EMAIL | INTERNAL | SLACK
  recipient         String
  status            DispatchStatus @default(PENDING)
  idempotencyKey    String         @unique
  externalMessageId String?
  errorMessage      String?
  retryCount        Int            @default(0)
  sentAt            DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  escalation        Escalation     @relation(fields: [escalationId], references: [id], onDelete: Cascade)

  @@index([escalationId, status])
}

enum DispatchStatus {
  PENDING
  SENT
  FAILED
}

model AutomationWebhookEvent {
  id          String    @id @default(cuid())
  eventId     String    @unique
  provider    String    @default("generic")
  payloadHash String
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([eventId, createdAt])
}

// ─────────────────────────────────────────────────────
// AGY-01: White-Label Client Portals & Agency Reporting Suite
// ─────────────────────────────────────────────────────
model AgencyBranding {
  id                   String       @id @default(cuid())
  orgId                String       @unique
  brandName            String?
  logoUrl              String?
  faviconUrl           String?
  primaryColor         String?      // Hex color code, e.g. #97781B
  accentColor          String?      // Hex color code
  supportEmail         String?
  portalTitle          String?
  hideReviewReplyBadge Boolean      @default(false)
  emailSenderName      String?
  replyToEmail         String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  org                  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

model CustomDomain {
  id                String       @id @default(cuid())
  orgId             String
  domain            String       @unique // e.g. reviews.agency.com
  status            DomainStatus @default(PENDING_VERIFICATION)
  verificationToken String       @unique // e.g. rr_verify_...
  cnameTarget       String       @default("cname.reviewreply.com")
  verifiedAt        DateTime?
  lastCheckedAt     DateTime?
  sslStatus         SslStatus    @default(PENDING)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  org               Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([domain, status])
}

enum DomainStatus {
  PENDING_VERIFICATION
  VERIFIED
  FAILED
  REVOKED
}

enum SslStatus {
  PENDING
  ACTIVE
  FAILED
}

model ClientPortalShare {
  id           String       @id @default(cuid())
  businessId   String
  orgId        String
  tokenHash    String       @unique // SHA-256 of public share token
  passcodeHash String?
  isEnabled    Boolean      @default(true)
  expiresAt    DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  business     Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([orgId])
}

model ReportDeliveryLog {
  id                String          @id @default(cuid())
  reportId          String
  orgId             String
  businessId        String?
  recipient         String
  format            ReportFormat
  status            DeliveryStatus  @default(QUEUED)
  idempotencyKey    String          @unique
  reportPeriod      String?
  periodStart       DateTime?
  periodEnd         DateTime?
  attempts          Int             @default(0)
  lastAttemptAt     DateTime?
  claimedAt         DateTime?
  providerMessageId String?
  error             String?
  sentAt            DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt @default(now())

  report            ScheduledReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  org               Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([reportId, createdAt])
  @@index([orgId, createdAt])
  @@index([businessId])
  @@index([status, claimedAt])
}

enum DeliveryStatus {
  QUEUED
  PROCESSING
  SENT
  FAILED
}
