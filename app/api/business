/**
 * app/api/businesses/[id]/review-requests/route.ts — list all review requests.
 *
 * Phase 3 / Day 24: GET /api/businesses/:id/review-requests — list + status,
 * all entry methods combined.
 */

import { NextRequest, NextResponse } from "next/server";
import { getStore } from "@/lib/db";
import { getCurrentUser } from "@/lib/auth";

export async function GET(_req: NextRequest, { params }: { params: { id: string } }) {
  const user = await getCurrentUser();
  if (!user) {
    return NextResponse.json({ ok: false, error: "Unauthorized" }, { status: 401 });
  }
  const store = await getStore();
  const business = await store.getBusinessById(params.id);
  if (!business || business.owner_user_id !== user.id) {
    return NextResponse.json({ ok: false, error: "Business not found" }, { status: 404 });
  }
  const requests = await store.listReviewRequests(business.id);
  return NextResponse.json({ ok: true, requests });
}